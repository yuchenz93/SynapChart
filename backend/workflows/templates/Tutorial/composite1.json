          },
          {
            "block_type_id": "get_phase_precession_r",
            "display_name": "Get Phase Precession_R",
            "category": "Visualization",
            "description": "Plots spike phase vs. position (the theta phase precession scatter plot).",
            "inputs": [
              {
                "port_id": "spikes",
                "data_type": "NeuroData[spike_times]",
                "description": "Spike timestamps (seconds).",
                "required": true
              },
              {
                "port_id": "phase",
                "data_type": "NeuroData[raw_signal]",
                "description": "Instantaneous LFP phase (radians).",
                "required": true
              },
              {
                "port_id": "position",
                "data_type": "NeuroData[position]",
                "description": "Linearized or 2-D position.",
                "required": true
              }
            ],
            "outputs": [
              {
                "port_id": "corr_r",
                "data_type": "float",
                "description": "correlation value"
              }
            ],
            "parameters": [
              {
                "name": "title",
                "data_type": "str",
                "default": "Phase Precession",
                "description": "Plot title.",
                "enum_values": ""
              },
              {
                "name": "show_on_run",
                "data_type": "bool",
                "default": "true",
                "description": "Open a pop-out window when executed.",
                "enum_values": ""
              },
              {
                "name": "save_path",
                "data_type": "str",
                "default": "",
                "description": "Path to save the PNG. Empty = no save.",
                "enum_values": ""
              },
              {
                "name": "position_range",
                "data_type": "str",
                "default": "auto",
                "description": "Position range 'auto' or 'min,max'.",
                "enum_values": ""
              }
            ],
            "source_snippet": "spikes: NeuroData = inputs[\"spikes\"]\nphase_nd: NeuroData = inputs[\"phase\"]\nposition: NeuroData = inputs[\"position\"]\n\nspike_times = spikes.array\nphase_arr = phase_nd.array if phase_nd.array.ndim == 1 else phase_nd.array[:, 0]\npos_arr = position.array if position.array.ndim == 1 else position.array[:, 0]\n\nsr_phase = phase_nd.sampling_rate or 1000.0\nsr_pos = position.sampling_rate or 30.0\n\nphase_times = phase_nd.timestamps if phase_nd.timestamps is not None else np.arange(len(phase_arr)) / sr_phase\npos_times = position.timestamps if position.timestamps is not None else np.arange(len(pos_arr)) / sr_pos\n\nspike_phases = np.interp(spike_times, phase_times, phase_arr, left=np.nan, right=np.nan)\nspike_pos = np.interp(spike_times, pos_times, pos_arr, left=np.nan, right=np.nan)\n\nvalid = ~(np.isnan(spike_phases) | np.isnan(spike_pos))\nspike_phases = spike_phases[valid]\nspike_pos = spike_pos[valid]\n\ncorr_r = float(np.corrcoef(spike_phases, spike_pos)[0, 1])\nreturn {\"corr_r\": corr_r}",
            "dependencies": []
          }
        ]
      }

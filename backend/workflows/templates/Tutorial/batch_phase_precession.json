  "local_blocks": [
    {
      "block_type_id": "plot_r_summary",
      "display_name": "Plot Session Summary",
      "category": "local",
      "description": "Bar chart of phase-precession r values collected across batch sessions.",
      "inputs": [
        {
          "port_id": "collection",
          "data_type": "NeuroData[any]",
          "description": "Stacked r values from collect_results (one scalar per session).",
          "required": true
        }
      ],
      "outputs": [],
      "parameters": [
        {
          "name": "title",
          "data_type": "str",
          "default": "Phase Precession Strength Across Sessions",
          "description": "Plot title.",
          "enum_values": ""
        }
      ],
      "source_snippet": "import matplotlib.pyplot as plt\nfrom blocks.visualization import save_and_encode\n\ncollection = inputs[\"collection\"]\nif hasattr(collection, \"array\"):\n    r_values = collection.array.flatten()\nelse:\n    r_values = np.asarray(collection).flatten()\n\nn = len(r_values)\nmean_r = float(r_values.mean())\ntitle = parameters.get(\"title\", \"Phase Precession Strength Across Sessions\")\n\ndisp(\"Phase precession r values per session:\")\nfor i, r in enumerate(r_values):\n    disp(f\"  Session {i + 1}: r = {r:.4f}\")\ndisp(f\"Mean r = {mean_r:.4f}  (n={n} sessions)\")\n\nlabels = [f\"Session {i + 1}\" for i in range(n)]\ncolors = [\"#3b82f6\" if r < 0 else \"#ef4444\" for r in r_values]\n\nfig, ax = plt.subplots(figsize=(max(5, n * 1.4), 4))\nbars = ax.bar(labels, r_values, color=colors, width=0.5, edgecolor=\"white\", linewidth=0.8)\nax.axhline(mean_r, color=\"#1e293b\", linewidth=1.5, linestyle=\"--\",\n           label=f\"mean = {mean_r:.3f}\")\nax.axhline(0, color=\"#9ca3af\", linewidth=0.8, linestyle=\":\", alpha=0.8)\nax.set_ylabel(\"Phase precession r\")\nax.set_title(title)\nax.legend(fontsize=10)\nax.spines[[\"top\", \"right\"]].set_visible(False)\ny_lo = min(-1.0, float(r_values.min()) - 0.1)\ny_hi = max(0.5, float(r_values.max()) + 0.1)\nax.set_ylim(y_lo, y_hi)\nfor bar, r in zip(bars, r_values):\n    va = \"top\" if r < 0 else \"bottom\"\n    offset = -0.02 if r < 0 else 0.02\n    ax.text(\n        bar.get_x() + bar.get_width() / 2,\n        r + offset,\n        f\"{r:.3f}\",\n        ha=\"center\",\n        va=va,\n        fontsize=9,\n        fontweight=\"bold\",\n    )\nfig.tight_layout()\n\nviz = save_and_encode(fig, \"\", True)\nreturn {\"_viz\": viz}",
      "dependencies": []
    }
  ],
  "composite_blocks": [
    {
      "schema_version": "1.0",
      "block_type": "composite",
      "block_type_id": "phaseprecession",
      "display_name": "PhasePrecession",
      "category": "Composite",
      "description": "Full theta phase precession pipeline. Accepts three file paths and outputs the Pearson r between spike phase and linearised position.",
      "inputs": [
        {
          "port_id": "lfp_path",
          "data_type": "str",
          "description": "Absolute path to the LFP .npy file.",
          "promoted_from": {
            "node_id": "load_lfp",
            "parameter": "file_path"
          },
          "default": ""
        },
        {
          "port_id": "spike_path",
          "data_type": "str",
          "description": "Absolute path to the spike-times .npy file.",
          "promoted_from": {
            "node_id": "load_spikes",
            "parameter": "file_path"
          },
          "default": ""
        },
        {
          "port_id": "pos_path",
          "data_type": "str",
          "description": "Absolute path to the position .npy file.",
          "promoted_from": {
            "node_id": "load_pos",
            "parameter": "file_path"
          },
          "default": ""
        }
      ],
      "outputs": [
        {
          "port_id": "corr_r",
          "data_type": "float",
          "description": "Pearson r (spike phase vs. linearised position).",
          "maps_to": {
            "node_id": "get_pp_r",
            "port_id": "corr_r"
          }
        }
      ],
      "subflow": {
        "local_blocks": [
          {
            "block_type_id": "get_phase_precession_r",
            "display_name": "Get Phase Precession R",
            "category": "Visualization",
            "description": "Computes Pearson correlation between spike phase and linearised position.",
            "inputs": [
              {
                "port_id": "spikes",
                "data_type": "NeuroData[spike_times]",
                "description": "Spike timestamps (seconds).",
                "required": true
              },
              {
                "port_id": "phase",
                "data_type": "NeuroData[raw_signal]",
                "description": "Instantaneous LFP phase (radians).",
                "required": true
              },
              {
                "port_id": "position",
                "data_type": "NeuroData[position]",
                "description": "Linearised position.",
                "required": true
              }
            ],
            "outputs": [
              {
                "port_id": "corr_r",
                "data_type": "float",
                "description": "Pearson r (phase vs. position)."
              }
            ],
            "parameters": [],
            "source_snippet": "spike_times = inputs[\"spikes\"].array\nphase_nd = inputs[\"phase\"]\nposition = inputs[\"position\"]\n\nphase_arr = phase_nd.array if phase_nd.array.ndim == 1 else phase_nd.array[:, 0]\npos_arr = position.array if position.array.ndim == 1 else position.array[:, 0]\n\nsr_phase = phase_nd.sampling_rate or 1000.0\nsr_pos = position.sampling_rate or 30.0\nphase_times = (\n    phase_nd.timestamps\n    if phase_nd.timestamps is not None\n    else np.arange(len(phase_arr)) / sr_phase\n)\npos_times = (\n    position.timestamps\n    if position.timestamps is not None\n    else np.arange(len(pos_arr)) / sr_pos\n)\n\nspike_phases = np.interp(spike_times, phase_times, phase_arr, left=np.nan, right=np.nan)\nspike_pos = np.interp(spike_times, pos_times, pos_arr, left=np.nan, right=np.nan)\n\nvalid = ~(np.isnan(spike_phases) | np.isnan(spike_pos))\nspike_phases = spike_phases[valid]\nspike_pos = spike_pos[valid]\n\ncorr_r = float(np.corrcoef(spike_phases, spike_pos)[0, 1])\ndisp(f\"Phase precession r = {corr_r:.4f}\")\nreturn {\"corr_r\": corr_r}",
            "dependencies": []
          }
        ],
